{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Precomputed Mars routes",
  "oneOf": [
    {
      "$ref": "#/$defs/artifact"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Feature"
        },
        "geometry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 2
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "properties": {
          "properties": {
            "id": {
              "type": "string"
            },
            "startId": {
              "type": "string"
            },
            "siteId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "provisional",
                "unavailable"
              ]
            },
            "unavailableReason": {
              "type": [
                "string",
                "null"
              ]
            },
            "distanceMeters": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "elevationGainMeters": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "maximumSlopeDegrees": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "requestedStart": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "requestedDestination": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "sites#/$defs/source"
              },
              "minItems": 2
            },
            "endpointCells": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "object",
                  "properties": {
                    "coordinates": {
                      "anyOf": [
                        {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 360
                            },
                            {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            }
                          ],
                          "minItems": 2,
                          "maxItems": 2
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "offsetMeters": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "required": [
                    "coordinates",
                    "offsetMeters"
                  ],
                  "additionalProperties": false
                },
                "destination": {
                  "type": "object",
                  "properties": {
                    "coordinates": {
                      "anyOf": [
                        {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 360
                            },
                            {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            }
                          ],
                          "minItems": 2,
                          "maxItems": 2
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "offsetMeters": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "required": [
                    "coordinates",
                    "offsetMeters"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "start",
                "destination"
              ],
              "additionalProperties": false
            },
            "meanRegionalSlopeDegrees": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "evidenceCoverage": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "pathCellCount",
                    "directCellCount",
                    "interpolatedCellCount",
                    "interpolatedDistanceMeters",
                    "interpolatedDistanceFraction",
                    "meanNeighborhoodInterpolationFraction"
                  ],
                  "properties": {
                    "pathCellCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "directCellCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "interpolatedCellCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "interpolatedDistanceMeters": {
                      "type": "number",
                      "minimum": 0
                    },
                    "interpolatedDistanceFraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "meanNeighborhoodInterpolationFraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "id",
            "startId",
            "siteId",
            "status",
            "unavailableReason",
            "distanceMeters",
            "elevationGainMeters",
            "maximumSlopeDegrees",
            "requestedStart",
            "requestedDestination",
            "warnings",
            "sources",
            "endpointCells",
            "meanRegionalSlopeDegrees",
            "evidenceCoverage"
          ],
          "additionalProperties": false,
          "type": "object"
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "properties": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "geometry": {
                "type": "null"
              },
              "properties": {
                "properties": {
                  "distanceMeters": {
                    "type": "null"
                  },
                  "elevationGainMeters": {
                    "type": "null"
                  },
                  "maximumSlopeDegrees": {
                    "type": "null"
                  },
                  "unavailableReason": {
                    "type": "string"
                  },
                  "meanRegionalSlopeDegrees": {
                    "type": "null"
                  },
                  "evidenceCoverage": {
                    "type": "null"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "geometry": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "LineString"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 360
                        },
                        {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 2
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "additionalProperties": false
              },
              "properties": {
                "properties": {
                  "distanceMeters": {
                    "type": "number",
                    "minimum": 0
                  },
                  "elevationGainMeters": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maximumSlopeDegrees": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unavailableReason": {
                    "type": "null"
                  },
                  "meanRegionalSlopeDegrees": {
                    "type": "number",
                    "minimum": 0
                  },
                  "evidenceCoverage": {
                    "type": "object",
                    "required": [
                      "pathCellCount",
                      "directCellCount",
                      "interpolatedCellCount",
                      "interpolatedDistanceMeters",
                      "interpolatedDistanceFraction",
                      "meanNeighborhoodInterpolationFraction"
                    ],
                    "properties": {
                      "pathCellCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "directCellCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "interpolatedCellCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "interpolatedDistanceMeters": {
                        "type": "number",
                        "minimum": 0
                      },
                      "interpolatedDistanceFraction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "meanNeighborhoodInterpolationFraction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "schemaVersion": {
          "const": "phase5-routes/1.1.0"
        },
        "planningVersion": {
          "type": "string"
        },
        "configuration": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "startId": {
              "type": "string"
            },
            "maximumSlopeDegrees": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 90
            },
            "slopePenalty": {
              "type": "number",
              "minimum": 0
            },
            "minimumNeighborhoodCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "allowProductInterpolation": {
              "type": "boolean"
            },
            "interpolationPenalty": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "version",
            "startId",
            "maximumSlopeDegrees",
            "slopePenalty",
            "minimumNeighborhoodCount",
            "allowProductInterpolation",
            "interpolationPenalty"
          ],
          "additionalProperties": false
        },
        "coordinateReference": {
          "type": "object",
          "required": [
            "body",
            "datum",
            "latitudeType",
            "longitudeDirection",
            "longitudeRange"
          ],
          "properties": {
            "body": {
              "const": "Mars"
            },
            "datum": {
              "type": "string"
            },
            "latitudeType": {
              "const": "planetocentric"
            },
            "longitudeDirection": {
              "const": "positive east"
            },
            "longitudeRange": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "inputProvenance": {
          "type": "object",
          "properties": {
            "assessmentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "topographyRasterSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "countsRasterSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "assessmentSha256",
            "topographyRasterSha256",
            "countsRasterSha256"
          ],
          "additionalProperties": false
        },
        "starts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "$ref": "sites#/$defs/location"
              }
            },
            "required": [
              "id",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "boundsDegrees": {
              "type": "object",
              "properties": {
                "west": {
                  "type": "number"
                },
                "east": {
                  "type": "number"
                },
                "south": {
                  "type": "number"
                },
                "north": {
                  "type": "number"
                }
              },
              "required": [
                "west",
                "east",
                "south",
                "north"
              ],
              "additionalProperties": false
            },
            "gridCellCount": {
              "type": "integer",
              "minimum": 1
            },
            "supportedCellCount": {
              "type": "integer",
              "minimum": 0
            },
            "directCellCount": {
              "type": "integer",
              "minimum": 0
            },
            "interpolatedCellCount": {
              "type": "integer",
              "minimum": 0
            },
            "invalidElevationCellCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "boundsDegrees",
            "gridCellCount",
            "supportedCellCount",
            "directCellCount",
            "interpolatedCellCount",
            "invalidElevationCellCount"
          ],
          "additionalProperties": false
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "planningVersion",
        "configuration",
        "coordinateReference",
        "inputProvenance",
        "starts",
        "coverage",
        "features"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "2.0.0"
        },
        "routeSchemaVersion": {
          "const": "phase5-routes/1.1.0"
        },
        "planningVersion": {
          "type": "string"
        },
        "coordinateReference": {
          "type": "object",
          "required": [
            "body",
            "datum",
            "latitudeType",
            "longitudeDirection",
            "longitudeRange"
          ],
          "properties": {
            "body": {
              "const": "Mars"
            },
            "datum": {
              "type": "string"
            },
            "latitudeType": {
              "const": "planetocentric"
            },
            "longitudeDirection": {
              "const": "positive east"
            },
            "longitudeRange": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "inputProvenance": {
          "type": "object",
          "properties": {
            "assessmentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "topographyRasterSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "countsRasterSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "assessmentSha256",
            "topographyRasterSha256",
            "countsRasterSha256"
          ],
          "additionalProperties": false
        },
        "route": {
          "$ref": "#/$defs/route"
        }
      },
      "required": [
        "schemaVersion",
        "routeSchemaVersion",
        "planningVersion",
        "coordinateReference",
        "inputProvenance",
        "route"
      ],
      "additionalProperties": false
    }
  }
}
